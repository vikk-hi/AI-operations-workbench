# Server bind address. Optional for read-only local mode; defaults to localhost.
SERVER_HOST=

# Server port. Optional for read-only local mode; defaults to 3000.
SERVER_PORT=

# Vite client port. Optional for read-only local mode; defaults to 8080.
CLIENT_DEV_PORT=

# Client base path. Optional for local mode; defaults to /.
CLIENT_BASE_PATH=

# Runtime mode. Optional; local scripts set an appropriate development value.
NODE_ENV=

# Log directory. Optional; defaults to logs and is ignored by Git.
LOG_DIR=

# Miaoda application type. Platform-only and not required for the static/read-only baseline.
MIAODA_APP_TYPE=

# Miaoda local-development marker. Platform-only and not required for the static/read-only baseline.
MIAODA_LOCAL_DEV=

# Miaoda authenticated user JSON. Leave empty for local read-only mode.
SUDA_WEBUSER=

# 本地网页真实飞书登录（需要飞书开放平台自建应用，不是妙搭 app_id）。
# 真实值只填写到 .env.local，请勿提交。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:3001/auth/callback
LOCAL_FRONTEND_URL=http://127.0.0.1:8080/client/index.html
LOCAL_AUTH_PORT=3001
